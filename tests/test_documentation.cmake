# Exercise positive and negative package-document checks without building code.
cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${WORK_ROOT}")
file(MAKE_DIRECTORY "${WORK_ROOT}/reference/docs" "${WORK_ROOT}/package/docs")
file(WRITE "${WORK_ROOT}/reference/README.md" "[Guide](docs/guide.md) [Again](docs/guide.md)\n")
file(WRITE "${WORK_ROOT}/reference/docs/guide.md" "[Home](../README.md)\n")
file(COPY "${WORK_ROOT}/reference/README.md" "${WORK_ROOT}/reference/docs" DESTINATION "${WORK_ROOT}/package")
function(check expected_error)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DDOCUMENT_ROOT=${WORK_ROOT}/package"
    "-DREFERENCE_ROOT=${WORK_ROOT}/reference" -P "${SOURCE_ROOT}/cmake/CheckDocumentation.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected_error STREQUAL "")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Valid documentation rejected: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected_error}")
    message(FATAL_ERROR "Expected ${expected_error}; got ${result}: ${output}${error}")
  endif()
endfunction()
check("")
file(REMOVE "${WORK_ROOT}/package/docs/guide.md")
check("Missing documentation file: docs/guide.md")
configure_file("${WORK_ROOT}/reference/docs/guide.md" "${WORK_ROOT}/package/docs/guide.md" COPYONLY)
file(APPEND "${WORK_ROOT}/package/docs/guide.md" "Changed\n")
check("Stale documentation file: docs/guide.md")
configure_file("${WORK_ROOT}/reference/docs/guide.md" "${WORK_ROOT}/package/docs/guide.md" COPYONLY)
file(WRITE "${WORK_ROOT}/package/docs/obsolete.md" "Obsolete\n")
check("Unexpected documentation guide inventory")
file(REMOVE "${WORK_ROOT}/package/docs/obsolete.md")
file(APPEND "${WORK_ROOT}/reference/docs/guide.md" "[Missing](missing.md)\n")
configure_file("${WORK_ROOT}/reference/docs/guide.md" "${WORK_ROOT}/package/docs/guide.md" COPYONLY)
check("Broken documentation link in docs/guide.md: missing.md")
