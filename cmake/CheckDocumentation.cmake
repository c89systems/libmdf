# Validate the portable README/docs tree, including extracted package copies.
# Local file links are checked without network access; URL fragments are not
# interpreted. REFERENCE_ROOT additionally requires the checkout's exact bytes
# and guide inventory, so archives cannot silently omit or retain stale guides.
cmake_minimum_required(VERSION 3.24)
if(NOT IS_DIRECTORY "${DOCUMENT_ROOT}")
  message(FATAL_ERROR "Missing documentation root: ${DOCUMENT_ROOT}")
endif()
file(GLOB guides RELATIVE "${DOCUMENT_ROOT}" "${DOCUMENT_ROOT}/docs/*.md")
set(documents README.md ${guides})
if(DEFINED REFERENCE_ROOT)
  file(GLOB expected_guides RELATIVE "${REFERENCE_ROOT}" "${REFERENCE_ROOT}/docs/*.md")
  set(expected README.md ${expected_guides})
  foreach(document IN LISTS expected)
    if(NOT EXISTS "${DOCUMENT_ROOT}/${document}")
      message(FATAL_ERROR "Missing documentation file: ${document}")
    endif()
    file(SHA256 "${REFERENCE_ROOT}/${document}" reference_hash)
    file(SHA256 "${DOCUMENT_ROOT}/${document}" actual_hash)
    if(NOT actual_hash STREQUAL reference_hash)
      message(FATAL_ERROR "Stale documentation file: ${document}")
    endif()
  endforeach()
  if(NOT guides STREQUAL expected_guides)
    message(FATAL_ERROR "Unexpected documentation guide inventory: ${guides}")
  endif()
endif()
foreach(document IN LISTS documents)
  if(NOT EXISTS "${DOCUMENT_ROOT}/${document}")
    message(FATAL_ERROR "Missing documentation file: ${document}")
  endif()
  file(READ "${DOCUMENT_ROOT}/${document}" content)
  string(REGEX MATCHALL "\\]\\([^\r\n)]+\\)" links "${content}")
  # Remove the unmatched ']' before treating matches as a CMake list.
  string(REPLACE "](" "" links "${links}")
  get_filename_component(directory "${DOCUMENT_ROOT}/${document}" DIRECTORY)
  foreach(link IN LISTS links)
    string(REGEX REPLACE "\\)$" "" target "${link}")
    if(target MATCHES "^([A-Za-z][A-Za-z0-9+.-]*:|//|#)")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" target "${target}")
    if(NOT EXISTS "${directory}/${target}")
      message(FATAL_ERROR "Broken documentation link in ${document}: ${target}")
    endif()
  endforeach()
endforeach()
